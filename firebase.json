{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "{/,**/*.@(html|js|css)}",
        "headers": [{ "key": "Cache-Control", "value": "max-age=0" }]
      },
      {
        "source": "manifest.json",
        "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
